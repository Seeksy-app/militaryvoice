{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "regions": [
    "pdx1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api"
    },
    {
      "source": "/go/(.*)",
      "destination": "/api"
    },
    {
      "source": "/og/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|s/|og/|go/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/nudges",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/broadcasts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reach",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/follow-ups",
      "schedule": "30 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/|s/|og/|go/).*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?militaryvoice\\.ai"
        }
      ],
      "destination": "https://www.militaryvoices.ai/$1",
      "permanent": true
    },
    {
      "source": "/((?!robots\\.txt$|sitemap\\.xml$).+)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?militarycreatoreconomy\\.com"
        }
      ],
      "destination": "https://www.militaryvoices.ai/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
