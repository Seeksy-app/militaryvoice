{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "regions": [
    "pdx1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api"
    },
    {
      "source": "/og/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|s/|og/).*)",
      "destination": "/index.html"
    }
  ]
}
