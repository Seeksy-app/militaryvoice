{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "regions": [
    "pdx1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api"
    },
    {
      "source": "/og/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|s/|og/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/nudges",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/broadcasts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reach",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/follow-ups",
      "schedule": "30 * * * *"
    }
  ]
}
