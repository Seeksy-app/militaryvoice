# /etc/mvingest/agent.env  (root:mvingest, mode 640). Never commit real values.
# The site's address (leave as is).
API_BASE=https://www.militaryvoices.ai
# The same secret as INGEST_TOKEN in the site's environment (Vercel).
INGEST_TOKEN=
# A Cloudflare R2 API token limited to the recordings bucket (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=militaryvoice-recordings
