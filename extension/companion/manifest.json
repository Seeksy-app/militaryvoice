{
  "manifest_version": 3,
  "name": "MilitaryVoices Companion",
  "version": "2.1.0",
  "description": "Add guests to your show, send videos to your Library and prep for interviews from any page, plus a Zoom recording reminder.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.militaryvoices.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "MilitaryVoices" },
  "content_scripts": [
    {
      "matches": ["https://*.zoom.us/j/*", "https://*.zoom.us/s/*", "https://*.zoom.us/start/*", "https://*.zoom.us/wc/*", "https://*.zoom.com/j/*", "https://*.zoom.com/wc/*"],
      "js": ["reminder.js"],
      "run_at": "document_idle"
    }
  ]
}
