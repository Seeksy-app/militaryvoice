[Unit]
Description=Build and restart the MilitaryVoices clipper when its code on main changes
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mv-clipper-update
# The wait for an idle worker can be long; never let systemd kill it halfway.
TimeoutStartSec=4h
